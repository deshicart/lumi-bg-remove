rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Processed images
    match /processed/{userId}/{imageId} {
      // Users can read their own processed images
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Only Firebase Functions can write processed images
      allow write: if false;
    }
    
    // Original images (if stored)
    match /original/{userId}/{imageId} {
      // Users can read and write their own original images
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024 && // 10MB max
                      request.resource.contentType.matches('image/.*');
    }
  }
}
